# ──────────────────────────────────────────────
#  RAG Application — Environment Configuration
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ──────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here

# Embedding model (text-embedding-3-large default = 1536 dims)
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=1536

# LLM for answer generation
OPENAI_LLM_MODEL=gpt-4o-mini

# ── Qdrant ──────────────────────────────────
# Local (default): http://localhost:6333
# Docker Compose:  http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# Minimum cosine similarity score to include a result (0.0 = no filter)
QDRANT_SCORE_THRESHOLD=0.3

# ── Inngest ─────────────────────────────────
INNGEST_APP_ID=rag-app
INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288

# ── Chunking ────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# ── Upload ──────────────────────────────────
UPLOAD_DIR=uploads
